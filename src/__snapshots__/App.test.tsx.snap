  <div
    class="app"
  >
    <header
      class="masthead"
    >
      <h1>
        VideoToMP3
      </h1>
    </header>
    <main
      class="content"
    >
      <section
        aria-label="영상 추가"
        class="drop"
      >
        <span
          aria-hidden="true"
